# 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# 应用配置
APP_NAME=本地知识库系统
APP_VERSION=1.0.0
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000
RELOAD=True
# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=knowledge_base
MYSQL_POOL_SIZE=10
# 数据库配置
CHROMA_DB_PATH=./indexes

# 文件配置
UPLOAD_DIR=./data
DOCUMENTS_DIR=./data/documents
CODE_DIR=./data/code
MAX_FILE_SIZE=104857600  # 100MB

# 日志配置
LOG_DIR=./logs
LOG_LEVEL=INFO

# 文本分块配置
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# 向量化配置
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu  # 改为 cuda 如果有GPU

# AI模型配置
LLM_MODEL_NAME=chatglm-6b
LLM_MODEL_PATH=
LLM_DEVICE=cpu  # 改为 cuda 如果有GPU
USE_LLM_QA=False  # 模板模式为False，启用LLM增强为True
LLM_PIPELINE=summarization  # summarization 或 text2text-generation
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# 检索配置
RETRIEVAL_K=3
SIMILARITY_THRESHOLD=0.5
USE_HYBRID_SEARCH=True
